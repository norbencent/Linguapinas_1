 "tips": [
  {
   "language_code": "tl",
   "tip": "Add 'po' or 'opo' to show respect to elders: 'Salamat po', 'Opo'."
  },
  {
   "language_code": "tl",
   "tip": "Tagalog often puts the verb first: 'Kumain ako' literally means 'Ate I'."
  },
  {
   "language_code": "tl",
   "tip": "'Ng' marks the object (Gusto ko ng tubig) while 'ang' marks the topic of the sentence."
  },
  {
   "language_code": "ilo",
   "tip": "'Apo' is a respectful way to address an elder or someone of high status."
  },
  {
   "language_code": "ilo",
   "tip": "'Unay' intensifies: 'Agyamanak unay' means 'Thank you very much'."
  },
  {
   "language_code": "pam",
   "tip": "'Pu' is the Kapampangan politeness marker, like Tagalog 'po'."
  },
  {
   "language_code": "pam",
   "tip": "'Ing' works like the Tagalog 'ang' to mark the topic: 'Nanu ing lagyu mu?'"
  },
  {
   "language_code": "bcl",
   "tip": "'Dios mabalos' (May God repay you) is the usual way to say thank you."
  },
  {
   "language_code": "bcl",
   "tip": "'Nin' marks the object, like Tagalog 'ng': 'Gusto ko nin tubig'."
  },
  {
   "language_code": "ceb",
   "tip": "Cebuano uses 'og' before an indefinite object: 'Gusto ko og tubig'."
  },
  {
   "language_code": "ceb",
   "tip": "'Dili' negates future or habitual actions; 'wala' negates past actions."
  },
  {
   "language_code": "hil",
   "tip": "Hiligaynon uses 'sang' before an indefinite object: 'Gusto ko sang tubig'."
  },
  {
   "language_code": "hil",
   "tip": "'Gid' adds emphasis: 'Madamo gid nga salamat' is a heartfelt thank you."
  },
  {
   "language_code": "war",
   "tip": "Waray uses 'hi' before personal names: 'Ako hi Juan'."
  },
  {
   "language_code": "war",
   "tip": "'Hin' marks an indefinite object: 'Karuyag ko hin tubig'."
  },
  {
   "language_code": "bis",
   "tip": "Mindanao Bisaya often borrows Tagalog words, e.g. 'pangalan' instead of Cebuano 'ngalan'."
  },
  {
   "language_code": "bis",
   "tip": "'Kaayo' means 'very': 'Salamat kaayo' means 'Thank you very much'."
  },
  {
   "language_code": "tsg",
   "tip": "'Magsukul' comes from the Arabic 'shukr', meaning gratitude."
  },
  {
   "language_code": "tsg",
   "tip": "Tausug greetings often follow Islamic custom: 'Assalamu alaikum'."
  },
  {
   "language_code": "cbk",
   "tip": "Chavacano words come mostly from Spanish, but the grammar is Philippine: 'Quiere yo agua' puts the verb first."
  },
  {
   "language_code": "cbk",
   "tip": "'Ya' marks a completed action: 'Ya come ya tu?' means 'Have you eaten?'."
  }
 ],
